# ─── Upstash Redis ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ─── Server ────────────────────────────────────────────────
PORT=3001
ADMIN_KEY=default-dev-key

# ─── CORS (comma-separated origins, * for all) ────────────
CORS_ORIGINS=*
